{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@kitajs/html",
    "plugins": [{ "name": "@kitajs/ts-html-plugin" }],
    "lib": ["ESNext", "ESNext.Iterator", "ESNext.Temporal"],
    "rootDir": "src/",
    "outDir": "dist/server/",
    "paths": {
      "@modules/*": ["./src/modules/*"],
      "@/*": ["./src/*"],
    },
  },
  "exclude": ["./client/*"],
}
